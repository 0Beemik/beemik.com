---
import Base from '../../layouts/Base.astro';

const faq = [
  {
    q: 'How do I play?',
    a: 'Tap anywhere to start. Bob runs by himself; tap to jump. Land on top of things, never hit anything face-first, and try to reach 10,000 metres.',
  },
  {
    q: "What's the difference between tapping and holding?",
    a: "A quick tap is a normal hop. Keep your finger down and the jump floats a little higher and longer. You never need the big jump to get through a level, but it's handy.",
  },
  {
    q: 'How do unlocks work?',
    a: 'Every 500 metres in a single run unlocks something new: a colour, a song, a sparkly or glowing finish, or a new shape. Some unlocks let you pick your own colour; tap it twice to choose. Unlocks belong to each difficulty, so what you earn on Easy stays on Easy.',
  },
  {
    q: 'Where do I change my colour, shape or music?',
    a: 'Tap MENU in the top corner (or press the Back button). A red "!" on the menu button means there is something new waiting for you.',
  },
  {
    q: 'Does my run save if I close the game?',
    a: 'Yes. Your run saves itself at checkpoints as you go. Close the game any time and it will be waiting, paused, when you come back.',
  },
  {
    q: 'When do ads show?',
    a: 'Never before 500 metres. After that, a short ad may play after a splat, at most once every few minutes. After a new best you can choose to watch an ad to keep going, or say no thanks. All ads are kid-safe and never personalized.',
  },
  {
    q: 'How do I reset my progress?',
    a: "Everything is stored on your device. Clearing BobBlob's storage in Android settings (or uninstalling it) starts you fresh.",
  },
];
---
<Base title="Support · BobBlob" description="Help and frequently asked questions for BobBlob." accent="#e0468f">
  <section class="doc narrow">
    <div>
      <span class="eyebrow">BobBlob</span>
      <h1>Support</h1>
      <p class="updated">Can't find an answer? Email <a href="mailto:support@beemik.com">support@beemik.com</a>.</p>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  details { border-top: 1px solid var(--line); padding: 16px 0; }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { font-weight: 700; font-size: 18px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  summary::after { content: '+'; color: var(--muted); font-size: 22px; line-height: 1; transition: transform .2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 10px 0 0; }
</style>
