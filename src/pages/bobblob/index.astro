---
import Base from '../../layouts/Base.astro';
import SupportLegal from '../../components/SupportLegal.astro';
import { bySlug } from '../../data/projects';

const p = bySlug('bobblob');
const img = (n: string) => `/img/bobblob/${n}.webp`;

// the gallery: real gameplay frames, captured straight from the game
const gallery = [
  { img: 'cube-snow', title: 'Sparkly Jelly Cube', where: 'Snowy Peaks', wide: true },
  { img: 'donut-candy', title: 'Rainbow Doughnut', where: 'Candy Land' },
  { img: 'heart-forest', title: 'Sparkly Jelly Heart', where: 'Forest' },
  { img: 'glow-cave', title: 'Glowing Bob', where: 'Cave' },
  { img: 'star-volcano', title: 'Gold Shimmer Star', where: 'Volcano' },
  { img: 'heart-space', title: 'Glowing Heart', where: 'Space Station' },
  { img: 'donut-toys', title: 'Glowing Doughnut', where: 'Toy Room' },
  { img: 'star-sea', title: 'Sparkly Star', where: 'Underwater' },
  { img: 'cube-dream', title: 'Rainbow Cube', where: 'Dreamscape' },
  { img: 'meadow', title: 'Classic Bob, mid-squish', where: 'Meadow', wide: true },
];

const worlds = [
  ['🌼', 'Meadow'], ['🌲', 'Forest'], ['🦇', 'Cave'], ['📦', 'Warehouse'], ['🍳', 'Kitchen'], ['🧸', 'Toy Room'], ['🌃', 'Rooftop'],
  ['🏖️', 'Beach'], ['🐠', 'Underwater'], ['❄️', 'Snowy Peaks'], ['🌋', 'Volcano'], ['🍭', 'Candy Land'], ['🚀', 'Space Station'], ['🌈', 'Dreamscape'],
];

const unlocks = [
  { m: '500 m', what: 'Sparkly Bob', icon: '✨' },
  { m: '2,500 m', what: 'Jelly Heart', icon: '💗' },
  { m: '4,000 m', what: 'Glowing Bob', icon: '💡' },
  { m: '5,000 m', what: 'Jelly Doughnut', icon: '🍩' },
  { m: '7,500 m', what: 'Jelly Star', icon: '⭐' },
  { m: '8,000 m', what: 'Gold Shimmer', icon: '🪙' },
  { m: '9,500 m', what: 'Rainbow Bob', icon: '🌈' },
  { m: '10,000 m', what: 'Jelly Cube', icon: '🧊' },
];
---
<Base title="BobBlob · Beemik" description={p.blurb} accent={p.accent}>
  <section class="hero wrap">
    <div class="copy">
      <div class="app-id reveal">
        <img src={p.icon} alt="" width="64" height="64" />
        <span class="chip status-soon"><span class="dot"></span>{p.statusLabel}</span>
      </div>
      <h1 class="reveal">Run. Jump.<br />Squish.<br /><span>SPLAT!</span></h1>
      <p class="lede reveal">
        Bob is a little blob of jelly with big plans: 10,000 metres through 14 wild worlds. Tap to jump, hold to jump higher,
        land on top of everything, and never, ever hit a face.
      </p>
      <div class="pills reveal">
        <span class="chip">👆 One-tap controls</span>
        <span class="chip">🌍 14 worlds</span>
        <span class="chip">🔓 Unlock as you go</span>
        <span class="chip">👨‍👩‍👧 Made with kids</span>
      </div>
    </div>
    <div class="player reveal">
      <div class="screen">
        <video id="trailer" src="/img/bobblob/trailer.mp4" poster={img('trailer-poster')} autoplay muted loop playsinline preload="metadata"
          aria-label="BobBlob gameplay trailer"></video>
        <button class="sound" id="sound" type="button" aria-pressed="false">🔇 Tap for sound</button>
      </div>
      <p class="credit">Real gameplay. Music: “Green Hills” by Igor Gundarev (CC0), one of nine songs in the game.</p>
    </div>
  </section>

  <section class="section band" id="looks">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">One blob, a lot of looks</span>
        <h2>Pick your jelly.</h2>
        <p>16 colours, 5 shapes and 5 finishes: sparkly, glowing, gold shimmer and rainbow. Every one of them squishes when it lands.</p>
      </div>
      <div class="gallery">
        {gallery.map((g) => (
          <figure class:list={['shot', 'reveal', { wide: g.wide }]}>
            <img src={img(g.img)} alt={`${g.title} in the ${g.where}`} loading="lazy" width="1600" height="720" />
            <figcaption><b>{g.title}</b><span>{g.where}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <figure class="shot big reveal">
        <img src={img('splat')} alt="A sparkly blue jelly cube going SPLAT in the Toy Room" loading="lazy" width="1600" height="720" />
      </figure>
      <div class="split-copy reveal">
        <span class="eyebrow">How to play</span>
        <h2>Two jumps. One rule.</h2>
        <p><b>Tap</b> for a hop. <b>Hold</b> for a jump that floats a little higher and longer. Bob runs on his own; your only job is timing.</p>
        <p>Land on top of things and you're fine. Hit something face-first and… <b>SPLAT!</b> Bob slides down the screen, pulls himself back together, and you go again.</p>
        <p class="small">Your run saves itself, so you can put the phone down any time and pick up where you left off.</p>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">10,000 metres</span>
        <h2>14 worlds to splat through.</h2>
        <p>Every 500 metres the world changes, with its own look, sounds and surprises.</p>
      </div>
      <div class="worlds reveal">
        {worlds.map((w, i) => <span class="world"><small>{(i * 500).toLocaleString('en-US')} m</small>{w[0]} {w[1]}</span>)}
      </div>
      <div class="wide-shots">
        <figure class="shot reveal"><img src={img('world-candy')} alt="Candy Land" loading="lazy" width="1600" height="720" /></figure>
        <figure class="shot reveal"><img src={img('world-snow')} alt="Snowy Peaks" loading="lazy" width="1600" height="720" /></figure>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Play to unlock</span>
      <h2>Go farther. Get more Bob.</h2>
      <p>Something new every 500 metres: colours, songs, finishes and shapes. Unlocks belong to each difficulty, so Hard is earned on Hard.</p>
    </div>
    <ol class="ladder reveal">
      {unlocks.map((u) => <li><span class="ic">{u.icon}</span><b>{u.what}</b><small>{u.m}</small></li>)}
    </ol>
    <div class="screens">
      <figure class="shot reveal"><img src={img('unlock')} alt="NEW UNLOCK! Sparkly Bob" loading="lazy" width="1600" height="720" /><figcaption><b>New unlock!</b><span>Pops up mid-run</span></figcaption></figure>
      <figure class="shot reveal"><img src={img('menu')} alt="The BobBlob menu with colours, looks and shapes" loading="lazy" width="1600" height="720" /><figcaption><b>Make him yours</b><span>Colours, looks, shapes and music</span></figcaption></figure>
    </div>
  </section>

  <section class="wrap fair reveal">
    <div class="fair-card">
      <span class="eyebrow">Fair to play</span>
      <h2>Free, with gentle ads.</h2>
      <p>
        No ads until you've run 500 metres. Ads are kid-safe, G-rated and never personalized. After a new best you can choose
        to watch one to keep going, or just say no thanks.
      </p>
    </div>
  </section>

  <SupportLegal
    links={[
      { label: 'Privacy policy', href: '/bobblob/privacy/', note: 'What the game stores and why' },
      { label: 'Support & FAQ', href: '/bobblob/support/', note: 'How to play, unlocks and common questions' },
    ]}
  />
</Base>

<script>
  // the trailer starts muted (browsers require it); one tap turns the music on
  const v = document.getElementById('trailer') as HTMLVideoElement | null;
  const b = document.getElementById('sound') as HTMLButtonElement | null;
  if (v && b) {
    b.addEventListener('click', () => {
      v.muted = !v.muted;
      if (!v.muted) { v.currentTime = 0; v.play(); }
      b.textContent = v.muted ? '🔇 Tap for sound' : '🔊 Sound on';
      b.setAttribute('aria-pressed', String(!v.muted));
    });
  }
</script>

<style>
  .hero { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 44px; align-items: center; padding: 70px 0 60px; }
  .app-id { display: flex; align-items: center; gap: 14px; }
  .app-id img { width: 64px; height: 64px; border-radius: 18px; box-shadow: var(--shadow); }
  h1 { font-size: clamp(44px, 6.4vw, 78px); font-weight: 800; margin: 22px 0 20px; }
  h1 span { color: var(--accent); }
  .lede { font-size: 19px; color: var(--muted); margin: 0 0 24px; }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }

  /* the trailer, in a phone held sideways */
  .screen { position: relative; padding: 12px; background: #1d1d1f; border-radius: 34px; box-shadow: var(--shadow-lift); }
  .screen video { display: block; width: 100%; aspect-ratio: 20 / 9; border-radius: 24px; background: #140c2e; }
  .sound {
    position: absolute; right: 26px; bottom: 26px; border: 0; cursor: pointer; font: 600 14px var(--body);
    padding: 8px 14px; border-radius: 999px; background: rgba(255, 255, 255, .92); color: var(--ink); box-shadow: var(--shadow);
  }
  .sound:hover { background: #fff; }
  .credit { color: var(--muted); font-size: 13px; margin: 12px 4px 0; }

  .shot { margin: 0; border-radius: 22px; overflow: hidden; background: #fff; box-shadow: var(--shadow); }
  .shot img { width: 100%; aspect-ratio: 20 / 9; object-fit: cover; }
  .shot figcaption { display: flex; justify-content: space-between; gap: 10px; padding: 12px 16px; font-size: 15px; }
  .shot figcaption span { color: var(--muted); }

  .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .gallery .wide { grid-column: 1 / -1; }

  .split { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: center; }
  .split-copy h2 { font-size: clamp(34px, 4.6vw, 50px); margin: 8px 0 16px; }
  .split-copy p { color: #424245; font-size: 18px; margin: 0 0 14px; }
  .split-copy .small { color: var(--muted); font-size: 15px; }

  .worlds { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; max-width: 880px; margin: 0 auto 44px; }
  .world { display: inline-flex; flex-direction: column; align-items: center; padding: 10px 16px; border-radius: 16px; background: #fff; box-shadow: var(--shadow); font-weight: 600; font-size: 15px; }
  .world small { color: var(--muted); font-weight: 500; font-size: 12px; }
  .wide-shots { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }

  .ladder { list-style: none; padding: 0; margin: 0 auto 44px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; max-width: 980px; }
  .ladder li { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 18px 10px; border-radius: 20px; background: var(--panel); }
  .ladder .ic { font-size: 30px; line-height: 1; margin-bottom: 8px; }
  .ladder b { font-family: var(--display); font-size: 17px; }
  .ladder small { color: var(--accent); font-weight: 600; }
  .screens { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }

  .fair-card { padding: clamp(28px, 6vw, 64px); text-align: center; background: var(--panel); border-radius: var(--radius); margin-bottom: 120px; }
  .fair-card h2 { font-size: clamp(32px, 5vw, 52px); margin: 10px 0 14px; }
  .fair-card p { color: var(--muted); max-width: 620px; margin: 0 auto; font-size: 18px; }

  @media (max-width: 900px) {
    .hero, .split { grid-template-columns: 1fr; }
    .hero { padding-top: 50px; }
    .ladder { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .gallery, .wide-shots, .screens { grid-template-columns: 1fr; }
    .screen { padding: 8px; border-radius: 24px; }
    .screen video { border-radius: 18px; }
    .sound { right: 16px; bottom: 16px; }
  }
</style>
