---
import Base from '../../layouts/Base.astro';

const faq = [
  {
    q: 'How do I set it up?',
    a: 'Install Family Chores on one device (a parent phone or a tablet on the kitchen counter works great), add your family members, then add chores. That device becomes the main device.',
  },
  {
    q: 'Can each kid use their own phone?',
    a: 'Yes. On the main device, go to Devices and tap "Add a device" to get a pairing code. On the kid\'s phone, install Family Chores, tap "Join my family" and enter the code. Both need to be on the same home Wi-Fi. No accounts needed.',
  },
  {
    q: "A phone isn't syncing. What do I check?",
    a: "Make sure both devices are on the same Wi-Fi network (not a guest network), the main device is on, and the app is open on both. Some routers block devices from seeing each other; turning off \"AP isolation\" fixes that.",
  },
  {
    q: 'What are points vs. coins?',
    a: 'Points decide who wins the week and can only be earned. Coins are pocket money for the family marketplace, where kids buy, sell and trade chores.',
  },
  {
    q: 'Can I remove ads?',
    a: 'Ads keep the app free. They are always kid-safe and never personalized.',
  },
  {
    q: 'How do I delete our data?',
    a: "Everything lives on your devices. Uninstall the app (or clear its storage in Android settings) on each device and it's gone.",
  },
];
---
<Base title="Support · Family Chores" description="Help and frequently asked questions for Family Chores." accent="#6c5ce7">
  <section class="doc narrow">
    <div>
      <span class="eyebrow">Family Chores</span>
      <h1>Support</h1>
      <p class="updated">Can't find an answer? Email <a href="mailto:support@beemik.com">support@beemik.com</a>.</p>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  details { border-top: 1px solid var(--line); padding: 16px 0; }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { font-weight: 700; font-size: 18px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  summary::after { content: '+'; color: var(--muted); font-size: 22px; line-height: 1; transition: transform .2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 10px 0 0; }
</style>
